 "recs": [
  {
   "id": "r0035e0f02b",
   "no": "WR-01",
   "text": "Check the delivery note and take a vapour-pressure sample of each new supplier's product before first unloading.",
   "responsible": "Operations",
   "priority": "Medium",
   "dueDate": "",
   "status": "Open",
   "closeout": ""
  },
  {
   "id": "r003687a8c6",
   "no": "WR-02",
   "text": "Write tanker key control into OP-PR-010: the operator holds the ignition key from earthing until disconnection.",
   "responsible": "Operations",
   "priority": "High",
   "dueDate": "",
   "status": "Open",
   "closeout": ""
  },
  {
   "id": "r00375cbebb",
   "no": "WR-03",
   "text": "Set up a hose and arm register with test dates; no transfer with a hose whose test is out of date.",
   "responsible": "Maintenance",
   "priority": "High",
   "dueDate": "",
   "status": "Open",
   "closeout": ""
  },
  {
   "id": "r00389a43cc",
   "no": "WR-04",
   "text": "Make continuous attendance mandatory during transfer and add a dead-man button on the unloading panel.",
   "responsible": "Operations",
   "priority": "High",
   "dueDate": "",
   "status": "Open",
   "closeout": ""
  },
  {
   "id": "r003920ce36",
   "no": "WR-05",
   "text": "Issue cold-resistant gloves and face shields at the unloading bay; depressurise the arm to the vapour line before disconnection.",
   "responsible": "HSE / process safety",
   "priority": "Medium",
   "dueDate": "",
   "status": "Open",
   "closeout": ""
  },
  {
   "id": "r00408177b2",
   "no": "WR-06",
   "text": "Test the bullet sprinklers annually with a flow test and record the coverage.",
   "responsible": "Fire officer",
   "priority": "High",
   "dueDate": "",
   "status": "Open",
   "closeout": ""
  },
  {
   "id": "r0041ceb129",
   "no": "WR-07",
   "text": "Install crash barriers around the bullet pipework and the unloading arm.",
   "responsible": "Civil engineer",
   "priority": "Medium",
   "dueDate": "",
   "status": "Open",
   "closeout": ""
  },
  {
   "id": "r0042bfb403",
   "no": "WR-08",
   "text": "Seal the drain pit next to the bullets or fit it with a water seal and a low-level gas detector.",
   "responsible": "Process engineer",
   "priority": "Medium",
   "dueDate": "",
   "status": "Open",
   "closeout": ""
  },
  {
   "id": "r00437bd009",
   "no": "WR-09",
   "text": "Prepare an LPG pre-incident plan with the municipal fire brigade and exercise it yearly.",
   "responsible": "HSE / process safety",
   "priority": "High",
   "dueDate": "",
   "status": "Open",
   "closeout": ""
  },
  {
   "id": "r0044d2d878",
   "no": "WR-10",
   "text": "Add an oxygen check (AT-01 reading) as a permissive before propane is admitted at start-up.",
   "responsible": "Instrument / SIS engineer",
   "priority": "High",
   "dueDate": "",
   "status": "Open",
   "closeout": ""
  },
  {
   "id": "r0045d19a83",
   "no": "WR-11",
   "text": "Introduce a trip-bypass register with time limits and shift sign-off.",
   "responsible": "Instrument / SIS engineer",
   "priority": "High",
   "dueDate": "",
   "status": "Open",
   "closeout": ""
  }
 ],
